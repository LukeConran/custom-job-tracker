# Supabase (required for hosted / shared use)
NEXT_PUBLIC_SUPABASE_URL=https://lzgbtyztepeunvvvvbmu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Preferred for ingest upserts — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If set, POST /api/ingest requires
# Authorization: Bearer <INGEST_SECRET>  or  x-ingest-secret: <INGEST_SECRET>
INGEST_SECRET=

# Local-first fallback: when the keys above are empty, the app stores
# data in .data/store.json (gitignored). Do not use that on Vercel.
